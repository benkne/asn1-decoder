#!/usr/bin/env bash
#
# Pre-push hook: run the same gates CI enforces so a red build never
# reaches GitHub. Mirrors .github/workflows/ci.yml (fmt + clippy).
#
# Enabled for everyone via `git config core.hooksPath .githooks`
# (run `bash .githooks/install.sh` once after cloning).
#
# Skip in an emergency with:  git push --no-verify
set -euo pipefail

echo "pre-push: cargo fmt --all -- --check"
cargo fmt --all -- --check

echo "pre-push: cargo clippy --workspace --all-targets -- -D warnings"
# -D warnings is what turns lints like float-literal-f32-fallback into
# errors in CI, so we deny here too to catch them before pushing.
RUSTFLAGS="-Dwarnings" cargo clippy --workspace --all-targets -- -D warnings

echo "pre-push: OK"
